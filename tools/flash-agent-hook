#!/bin/bash
#
# flash-agent-hook — Claude Code hook entry point. Register it (async) for
# Notification, PermissionRequest, PostToolUse, PostToolUseFailure,
# PermissionDenied, Stop and UserPromptSubmit; README → "Agent alerts".
#
# The work happens in the Swift binary next to Flash's (Contents/MacOS), so
# filtering, redaction and the secret patterns exist once, in
# Sources/FlashCore, and a tool's output is judged and dropped before
# anything reaches disk. This path stays so existing settings keep working.

here="$(cd "$(dirname "$0")" && pwd)"
for bin in "$here/../MacOS/flash-agent-hook" \
           "$here/../.build/release/FlashAgentHook" \
           "$here/../.build/debug/FlashAgentHook"; do
    [[ -x "$bin" ]] && exec "$bin"
done
exit 0
